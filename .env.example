# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py

# Security - Generate a strong secret key for production
# You can generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Database Configuration
# Development (SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Production (PostgreSQL example)
# DATABASE_URL=postgresql://username:password@localhost:5432/tododb

# Rate Limiting (optional, defaults to in-memory)
# For production, use Redis:
# RATELIMIT_STORAGE_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
